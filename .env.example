# AgentWire — environment variables. None are needed to serve the site or run the smoke test.
# Copy to .env only if you use the optional tooling below. Never commit .env.

# scripts/webmcp-smoke.mjs — set to also exercise the write tool (inserts one dependency_lists row)
WEBMCP_TEST_EMAIL=
# scripts/webmcp-smoke.mjs, demo/*.mjs — override the Chrome binary (default: /Applications/Google Chrome.app/...)
CHROME=

# demo/capture-agent.mjs — Gemini function-calling agent shown on screen in the demo video
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK=gemini-2.0-flash

# supabase/functions/run — only for whoever operates the diff engine (lives in Supabase secrets, not here)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# AGENTWIRE_RUN_TOKEN=   # x-run-token header for manual engine runs
